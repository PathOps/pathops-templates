apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ app.name }}
  labels: {app.kubernetes.io/name: {{ app.name }}}
spec:
  replicas: 1
  selector:
    matchLabels: {app.kubernetes.io/name: {{ app.name }}}
  template:
    metadata:
      labels: {app.kubernetes.io/name: {{ app.name }}}
    spec:
      # The Preflight runtime identity PathOps provisions: the kubelet pulls
      # the private image from the Cell registry with it.
      serviceAccountName: {{ app.name }}-runtime
      automountServiceAccountToken: false
      securityContext: {runAsNonRoot: true, runAsUser: 65532, runAsGroup: 65532, seccompProfile: {type: RuntimeDefault}}
      containers:
        - name: app
          # Set by update-preflight-gitops to the build's exact
          # <repository>:<revision>@<digest>, never a placeholder that runs.
          image: app
          ports:
            - {name: http, containerPort: 8080}
          readinessProbe:
            httpGet: {path: /healthz, port: http}
          livenessProbe:
            httpGet: {path: /healthz, port: http}
          securityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: {drop: [ALL]}}
          resources:
            requests: {cpu: 10m, memory: 16Mi}
            limits: {memory: 64Mi}
